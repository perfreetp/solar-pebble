{
  "name": "spaceport-layout-review",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test:unit": "esbuild scripts/smoke.ts --bundle --platform=node --format=esm --outfile=scripts/.smoke.mjs --log-level=warning && node scripts/.smoke.mjs",
    "test:chain": "esbuild scripts/version-chain.ts --bundle --platform=node --format=esm --outfile=scripts/.vc.mjs --log-level=warning && node scripts/.vc.mjs",
    "test:e2e": "node scripts/e2e.mjs",
    "test:stability": "node scripts/stability.mjs",
    "test:persistence": "node scripts/persistence.mjs"
  },
  "dependencies": {
    "solid-js": "^1.9.3"
  },
  "devDependencies": {
    "puppeteer-core": "^23.8.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-solid": "^2.10.2"
  }
}
